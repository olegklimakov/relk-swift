    "Double-tap to retry.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to retry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь дважды, чтобы отправить ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться двічі, щоб надіслати ще раз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltippen, um erneut zu senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para reenviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois pour renvoyer."
          }
        },
        "it": {
