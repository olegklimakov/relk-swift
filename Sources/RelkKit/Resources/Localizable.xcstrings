            "value": "Controlla la connessione e riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique sua conexão e tente de novo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
