    "Something went wrong on our side. Please try again later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong on our side. Please try again later."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то пошло не так. Попробуйте позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щось пішло не так. Спробуйте пізніше."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Da ist etwas schiefgelaufen. Bitte versuch es später noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu. Réessayez plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa è andato storto. Riprova più tardi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ging iets mis. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś poszło nie tak. Spróbuj później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado. Tente mais tarde."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sorun oluştu. Lütfen daha sonra tekrar deneyin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題が発生しました。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제가 발생했습니다. 잠시 후 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出了点问题，请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發生問題，請稍後再試。"
          }
        }
      }
    },
    "The developer reads every message personally. Replies show up right here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The developer reads every message personally. Replies show up right here."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разработчик сам читает каждое сообщение. Ответ появится здесь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розробник особисто читає кожне повідомлення. Відповідь з’явиться тут."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Entwickler liest jede Nachricht selbst. Antworten erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El desarrollador lee cada mensaje personalmente. Las respuestas aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le développeur lit chaque message lui-même. Les réponses s’affichent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo sviluppatore legge personalmente ogni messaggio. Le risposte arriveranno qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ontwikkelaar leest elk bericht zelf. Antwoorden verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twórca aplikacji osobiście czyta każdą wiadomość. Odpowiedzi pojawią się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desenvolvedor lê cada mensagem pessoalmente. As respostas aparecem aqui."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirici her mesajı kendisi okur. Yanıtlar burada görünür."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのメッセージに開発者本人が目を通します。返信はここに届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발자가 모든 메시지를 직접 읽습니다. 답장은 여기에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发者会亲自阅读每条消息，回复会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開發者會親自閱讀每則訊息，回覆會顯示在這裡。"
          }
        }
      }
    },
