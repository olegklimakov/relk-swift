    "Call Relk.configure(appKey:) at launch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call Relk.configure(appKey:) at launch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вызовите Relk.configure(appKey:) при запуске."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Викличте Relk.configure(appKey:) під час запуску."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rufe beim Start Relk.configure(appKey:) auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llama a Relk.configure(appKey:) al iniciar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appelez Relk.configure(appKey:) au lancement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiama Relk.configure(appKey:) all’avvio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Roep Relk.configure(appKey:) aan bij het opstarten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wywołaj Relk.configure(appKey:) przy uruchomieniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chame Relk.configure(appKey:) ao iniciar o app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açılışta Relk.configure(appKey:) çağırın."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動時にRelk.configure(appKey:)を呼び出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 실행 시 Relk.configure(appKey:)를 호출하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在启动时调用 Relk.configure(appKey:)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在啟動時呼叫 Relk.configure(appKey:)。"
          }
        }
      }
    },
    "Check your connection and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте подключение к интернету и попробуйте ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте підключення до інтернету й спробуйте ще раз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe deine Verbindung und versuch es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
